      <note><chord/><pitch><step>G</step><octave>3</octave></pitch><duration>1024</duration><voice>5</voice><type>whole</type><staff>2</staff></note>
    </measure>
    <measure number="2">
      <barline location="left"><bar-style>heavy-light</bar-style><repeat direction="forward"/></barline>
      <direction placement="above"><direction-type><rehearsal font-weight="bold">A</rehearsal></direction-type><staff>1</staff></direction>
