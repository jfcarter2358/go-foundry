      <backup><duration>1024</duration></backup>
      <note><rest measure="yes"/><duration>1024</duration><voice>5</voice><staff>2</staff></note>
      <barline location="right"><bar-style>light-heavy</bar-style><repeat direction="backward"/></barline>
    </measure>
    <measure number="4">
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1024</duration><voice>1</voice><type>whole</type><staff>1</staff><notations><arpeggiate/></notations></note>
      <note><chord/><pitch><step>B</step><octave>4</octave></pitch><duration>1024</duration><voice>1</voice><type>whole</type><staff>1</staff><notations><arpeggiate/></notations></note>
      <note><chord/><pitch><step>D</step><octave>5</octave></pitch><duration>1024</duration><voice>1</voice><type>whole</type><staff>1</staff><notations><arpeggiate/></notations></note>
      <backup><duration>1024</duration></backup>
