      <note><pitch><step>G</step><octave>3</octave></pitch><duration>256</duration><voice>5</voice><type>quarter</type><staff>2</staff></note>
      <note><pitch><step>D</step><octave>4</octave></pitch><duration>256</duration><voice>5</voice><type>quarter</type><staff>1</staff></note>
      <direction placement="below"><direction-type><pedal type="stop" line="yes"/></direction-type><offset>0</offset><staff>2</staff></direction>
    </measure>
    <measure number="3">
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>512</duration><tie type="start"/><voice>1</voice><type>half</type><staff>1</staff><notations><tied type="start"/></notations></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>256</duration><tie type="stop"/><voice>1</voice><type>quarter</type><staff>1</staff><notations><tied type="stop"/></notations></note>
