      <note><pitch><step>F</step><alter>1</alter><octave>5</octave></pitch><duration>57</duration><voice>1</voice><type>eighth</type><accidental>sharp</accidental><time-modification><actual-notes>9</actual-notes><normal-notes>4</normal-notes></time-modification><staff>1</staff><notations><tuplet type="start" number="2" bracket="yes"/></notations></note>
      <note><pitch><step>G</step><octave>5</octave></pitch><duration>57</duration><voice>1</voice><type>eighth</type><time-modification><actual-notes>9</actual-notes><normal-notes>4</normal-notes></time-modification><staff>1</staff></note>
      <note><pitch><step>A</step><octave>5</octave></pitch><duration>57</duration><voice>1</voice><type>eighth</type><time-modification><actual-notes>9</actual-notes><normal-notes>4</normal-notes></time-modification><staff>1</staff><notations><tuplet type="stop" number="2"/></notations></note>
      <note><pitch><step>B</step><octave>5</octave></pitch><duration>170</duration><voice>1</voice><type>quarter</type><time-modification><actual-notes>3</actual-notes><normal-notes>2</normal-notes></time-modification><staff>1</staff><notations><tuplet type="stop" number="1"/></notations></note>
      <direction placement="below"><direction-type><wedge type="stop"/></direction-type><voice>1</voice><staff>1</staff></direction>
      <direction placement="below"><direction-type><dynamics><f/></dynamics></direction-type><voice>1</voice><staff>1</staff></direction>
      <note><pitch><step>C</step><octave>6</octave></pitch><duration>512</duration><voice>1</voice><type>half</type><staff>1</staff></note>
      <backup><duration>1024</duration></backup>
      <direction placement="below"><direction-type><pedal type="start" line="yes"/></direction-type><staff>2</staff></direction>
