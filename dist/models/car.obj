# Blocky car silhouette, ~4x1.5x2 units, centered at origin
# Simple box body with a raised cabin section

# Body vertices (4 x 0.8 x 2 box, bottom at y=0)
v -2.0  0.0 -1.0
v  2.0  0.0 -1.0
v  2.0  0.8 -1.0
v -2.0  0.8 -1.0
v -2.0  0.0  1.0
v  2.0  0.0  1.0
v  2.0  0.8  1.0
v -2.0  0.8  1.0

# Cabin vertices (2.0 x 0.7 x 1.6 box, on top of body)
v -0.9  0.8 -0.8
v  1.2  0.8 -0.8
v  1.2  1.5 -0.8
v -0.9  1.5 -0.8
v -0.9  0.8  0.8
v  1.2  0.8  0.8
v  1.2  1.5  0.8
v -0.9  1.5  0.8

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Body front
f 2/2 1/1 4/4
f 2/2 4/4 3/3
# Body back
f 5/1 6/2 7/3
f 5/1 7/3 8/4
# Body left
f 1/1 5/2 8/3
f 1/1 8/3 4/4
# Body right
f 6/1 2/2 3/3
f 6/1 3/3 7/4
# Body bottom
f 1/1 2/2 6/3
f 1/1 6/3 5/4
# Body top (partial — cabin sits here, draw remaining strips)
f 4/1 8/2 13/3
f 4/1 13/3 9/4
f 7/1 3/2 10/3
f 7/1 10/3 14/4

# Cabin front
f 10/2 9/1 12/4
f 10/2 12/4 11/3
# Cabin back
f 13/1 14/2 15/3
f 13/1 15/3 16/4
# Cabin left
f 9/1 13/2 16/3
f 9/1 16/3 12/4
# Cabin right
f 14/1 10/2 11/3
f 14/1 11/3 15/4
# Cabin top
