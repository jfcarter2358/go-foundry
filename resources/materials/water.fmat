# water.fmat — the default water (docs/terrain-paint/PHASE_W1.md).
#
# Depth colour, refraction and a soft shoreline from the scene under the
# surface, sky and screen-space reflection, a GGX sun glint, drifting ripples,
# shore foam and caustics on the bed. Put a brush face on this and it is water;
# a generated lake's tiles (region_terrain) wear it, or a preset, or their own.
#
# Every number here is the engine's own default spelled out (material.
# DefaultWater), so the file is a worked example: delete a line to take that
# parameter back to the default it already equals. The presets beside it —
# water_tropical, water_alpine, water_lake, water_river, water_swamp, water_sea
# — are this with the colours and the motion changed.
kind: surface
texture: water
doc: 'Still water, the default: a clear temperate lake or pond. Put it on a flat face.'
effects:
  - effect: water
    wave_amplitude: 0.03
    wave_length: 4
    wave_speed: 0.3
    reflectivity: 0.5
    reflect_color: {r: 1, g: 1, b: 1}
    absorption: 0.6
    shallow_color: {r: 0.55, g: 0.8, b: 0.82}
    scatter_color: {r: 0.025, g: 0.11, b: 0.14}
    subsurface: 0.5
    roughness: 0.06
    refraction: 0.35
    foam: 0.5
    shore_fade: 0.12
    flow_speed: 0.25
    flow_direction: [1, 0.35]
    detail_scale: 3
    detail_strength: 1
    swell: 0
    swell_length: 24
    caustics: 1
    ssr: 1
