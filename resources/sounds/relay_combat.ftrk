version: 1
name: Relay Combat
bpm: 130
lpb: 4
ticks_per_row: 6
beats_per_bar: 4
fx_columns: 2
gain: 0.7
loop: false
beat_events: true
channels:
  - name: Kick
    volume: 0.95
  - name: Snare
    volume: 0.75
    send_a: 0.35
  - name: Hat
    volume: 0.4
    pan: 0.3
  - name: Bass
    volume: 0.85
    drive: 0.08
  - name: Sub
    volume: 0.6
  - name: Arp
    volume: 0.45
    pan: -0.3
    send_a: 0.25
    send_b: 0.45
  - name: Pad 1
    volume: 0.55
    pan: -0.4
    send_a: 0.5
  - name: Pad 2
    volume: 0.55
    pan: 0.4
    send_a: 0.5
  - name: Stabs
    volume: 0.6
    send_a: 0.3
    send_b: 0.2
  - name: Lead
    volume: 0.7
    send_a: 0.4
    send_b: 0.35
  - name: Drone
    volume: 0.5
    send_a: 0.4
  - name: Toms
    volume: 0.6
    send_a: 0.3
  - name: FX
    volume: 0.7
    send_a: 0.5
instruments:
  - name: Kick
    samples: [drums/kick_industrial]
  - name: Snare
    samples: [drums/snare_gated]
  - name: Hat
    samples: [drums/hat_closed_tight]
  - name: Bass
    samples: [bass/bass_moog]
    filter: lowpass
    cutoff: 900
    resonance: 0.35
    filter_env: {points: [[0, 1.4], [0.12, 0]], sustain: 1}
    volume_env: {points: [[0, 1], [0.1, 0.7], [0.14, 0]], sustain: 1}
    fade_out: 0.05
  - name: Reese
    samples: [bass/bass_reese]
    volume_env: {points: [[0, 0], [0.3, 1.0], [0.9, 0]], sustain: 1}
    fade_out: 0.2
    filter: lowpass
    cutoff: 700
  - name: Sync arp
    samples: [leads/lead_sync]
    filter: lowpass
    cutoff: 4500
    resonance: 0.3
    volume_env: {points: [[0, 1], [0.08, 0.4], [0.15, 0]]}
  - name: PWM pad
    samples: [pads/pad_pwm]
    volume_env: {points: [[0, 0], [0.8, 1.0], [2.3, 0]], sustain: 1}
    fade_out: 0.3
    filter: lowpass
    cutoff: 2600
    polyphony: 2
  - name: Sweep pad
    samples: [pads/pad_sweep]
    volume_env: {points: [[0, 0], [1.2, 1.0], [3.2, 0]], sustain: 1}
    fade_out: 0.3
    polyphony: 2
  - name: Stab
    samples: [winds/brass_section]
    volume_env: {points: [[0, 0], [0.01, 1], [0.25, 0.5], [0.45, 0]]}
  - name: Lead
    samples: [leads/lead_pwm]
    volume_env: {points: [[0, 0], [0.05, 1.0], [0.55, 0]], sustain: 1}
    fade_out: 0.2
    vibrato_rate: 5.5
    vibrato_depth: 0.1
    vibrato_delay: 0.3
    filter: lowpass
    cutoff: 5000
  - name: Drone
    samples: [pads/drone_scifi]
    volume_env: {points: [[0, 0], [2, 1.0], [5, 0]], sustain: 1}
    fade_out: 0.5
  - name: Tom
    samples: [drums/tom_808]
  - name: Crash
    samples: [drums/crash]
  - name: Riser
    samples: [fx/fx_riser]
  - name: Impact
    samples: [fx/fx_impact]
  - name: Choir
    samples: [pads/pad_choir]
    volume_env: {points: [[0, 0], [1, 1.0], [3, 0]], sustain: 1}
    fade_out: 0.3
order: [0, 1, 2, 3, 2, 4, 5, 6]
sections:
  - {name: intro, start: 0, end: 2, next: combat}
  - {name: combat, start: 2, end: 7, loop: true}
  - {name: outro, start: 7, end: 8}
params:
  - {name: intensity, default: 0.8}
bindings:
  - {param: intensity, channel: Lead, target: volume, from: 0.2, to: 1}
  - {param: intensity, channel: Stabs, target: volume, from: 0, to: 1}
  - {param: intensity, channel: Kick, target: volume, from: 0.4, to: 1}
  - {param: intensity, channel: Snare, target: volume, from: 0.2, to: 1}
  - {param: intensity, channel: Bass, target: cutoff, from: 500, to: 9000}
markers:
  1: combat
reverb: {size: 0.75, damping: 0.4, width: 1, return: 0.8}
delay: {beats: 0.75, feedback: 0.4, tone: 0.55, ping_pong: true, return: 0.6}
compressor: {threshold: -14, ratio: 3, attack: 0.01, release: 0.15, makeup: 2}
