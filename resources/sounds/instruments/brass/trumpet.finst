version: 1
name: Trumpet in B♭
samples: [winds/trumpet, orchestral/trumpet_soft]
zones:
- sample: 0
  low: C-0
  high: B-9
  layers:
  - sample: 1
    velocity: [0, 96]
  - sample: 0
    velocity: [64, 127]
fade_out: 0.1
articulations:
- name: staccato
  triggers: [stacc., staccatissimo]
  fade_out: 0.05
- name: marcato
  triggers: [accent, sfz, marc.]
  gain: 1
  volume_env:
    points: [[0, 0], [0.01, 1.25], [0.12, 0.85], [0.3, 0]]
    sustain: 2
- name: tremolo
  triggers: [flz., flutter, trem.]
  volume_env:
    points: [[0, 0], [0.012, 1], [0.042, 0.38], [0.072, 1], [0.3, 0]]
    loop_start: 1
    loop_end: 3
- name: muted
  triggers: [con sord., mute, muted, sord.]
  zones:
  - sample: 1
    low: C-0
    high: B-9
  gain: -6
playback:
  range: [E-3, C-6]
  transposition: -2
  clef: treble
  gliss: chromatic
description: 'Trumpet in B-flat: brightness follows how hard it is blown'
