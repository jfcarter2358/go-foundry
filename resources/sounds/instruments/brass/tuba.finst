version: 1
name: Tuba
samples: [orchestral/tuba_c2]
zones:
- sample: 0
  low: C-0
  high: B-9
fade_out: 0.15
articulations:
- name: staccato
  triggers: [stacc., staccatissimo]
  fade_out: 0.05
- name: marcato
  triggers: [accent, sfz, marc.]
  gain: 1
  volume_env:
    points: [[0, 0], [0.01, 1.25], [0.12, 0.85], [0.3, 0]]
    sustain: 2
- name: tremolo
  triggers: [flz., flutter, trem.]
  volume_env:
    points: [[0, 0], [0.012, 1], [0.042, 0.38], [0.072, 1], [0.3, 0]]
    loop_start: 1
    loop_end: 3
playback:
  range: [D-1, F-4]
  clef: bass
  gliss: chromatic
description: 'Tuba: the bass of the brass'
