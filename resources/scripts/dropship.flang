-- dropship.flang — walk in, the door shuts, the floor falls away.
--
-- Attached to the `dropship` entity type, which binds the two refs it needs:
-- `door` is the doorway sector whose CEILING is the blast door (see
-- chunks/dropship_hold.yaml — the leaf is a portal's gap geometry, so lowering
-- that ceiling both draws the door and seals the way through), and `bay` is the
-- hold, because being aboard and being *in* the hold are not the same thing:
-- someone standing in the aft vestibule is outside the door about to close.
--
-- Nothing here steers. The drop is a scripted descent, not a flight model: the
-- ship is not a vehicle, has no seats, and the passenger rides it because they
-- are standing in its frame, which carries them exactly with no work from this
-- file at all.
--
-- The phase lives in `@self.state` rather than in an attribute because it is
-- bookkeeping: the door's real state is the ceiling height, which the level
-- file already records, and a saved phase could only ever disagree with it.

param door ref                    -- the doorway sector; its ceiling is the leaf
param bay ref                     -- the hold, where a passenger has to be
param engine ref                  -- a placed sound to run while it flies; optional

param open_height float = 2.4     -- the leaf, stowed
param shut_height float = 0.0     -- …and seated. Must be at or below the floor
                                  -- either side, or the closed door admits.
param door_speed float = 1.6      -- metres a second

param drop_height float = 200.0   -- how far below the bay the surface is
param drop_speed float = 26.0
param shake float = 0.05          -- how far the hull wanders while under way

param launch_delay float = 2.0    -- seconds aboard before the door starts to shut
param auto_launch bool = true     -- false leaves it to the interact key

-- ---------------------------------------------------------------- the door --

-- set_door is the only place the leaf's height is written. Each write rebuilds
-- the sector and its gap geometry, so it happens once a frame while the door is
-- moving and not at all while it is parked.
def set_door(h float) -> null
    if ?door == null
        return
    end
    ?door.ceil.prop.height = h
end

def door_height() -> float
    if ?door == null
        return ?open_height
    end
    return ?door.ceil.prop.height
end

-- ------------------------------------------------------------- who is where --

-- aboard is true only for a player standing in the hold. `frame` says they are
-- inside the ship at all; `current_sector` says they are past the door. Without
-- the second test the ship would leave with someone on the vestibule's deck,
-- outside the sealed volume and standing in the open doorway.
def aboard() -> bool
    if @player == null
        return false
    end
    if @player.prop.frame != @self
        return false
    end
    if ?bay == null
        return true
    end
    return @player.prop.current_sector == ?bay.id
end

-- ------------------------------------------------------------------- easing --

-- ease ramps the descent up at the top and down at the bottom, so the ride
-- starts and finishes as a push rather than a jolt. Never zero: a drop that
-- eased all the way to nothing would never arrive.
def ease(t float) -> float
    e = 1.0
    if t < 0.12
        e = t / 0.12
    elif t > 0.88
        e = (1.0 - t) / 0.12
    end
    return clamp(e, 0.15, 1.0)
end

-- wobble is the ride: two sine waves at rates that do not divide into each
-- other, so the hull wanders rather than oscillating. Driven off play time
-- rather than off anything random, which makes a drop repeatable — a shake that
-- differs every run is one nobody can tune.
def wobble(amount float, rate float, phase float) -> float
    return amount * sin(time() * rate + phase)
end

-- -------------------------------------------------------------- the phases --

def on_spawn(:spawn:) -> null
    @self.state["phase"] = :parked:
    @self.state["wait"] = 0.0
    set_door(?open_height)
end

def on_tick(:tick:, dt float) -> null
    phase = @self.state["phase"]
    if phase == :parked:
        tick_parked(dt)
    elif phase == :closing:
        tick_closing(dt)
    elif phase == :dropping:
        tick_dropping(dt)
    elif phase == :opening:
        tick_opening(dt)
    end
end

-- Parked: count how long someone has been aboard, and go when they have stood
-- still long enough. Stepping back out resets the count rather than cancelling
-- a launch, because the launch has not started.
def tick_parked(dt float) -> null
    if not ?auto_launch
        return
    end
    if not aboard()
        @self.state["wait"] = 0.0
        return
    end
    @self.state["wait"] = @self.state["wait"] + dt
    if @self.state["wait"] >= ?launch_delay
        @self <- (:launch:,)
    end
end

-- The interact key is the other way in, and the only one when `auto_launch` is
-- off. The guard is what makes pressing it mid-drop do nothing.
def on_interact(:interact:, src ref) -> null
    if @self.state["phase"] == :parked: and aboard()
        @self <- (:launch:,)
    end
end

def on_launch(:launch:) when @self.state["phase"] == :parked: -> null
    @self.state["phase"] = :closing:
    play_sound("click", @self)
    log("dropship: closing up")
end

-- Closing: run the leaf down. Reaching the stop is what releases the ship, so
-- the drop can never start with the door still open.
def tick_closing(dt float) -> null
    h = door_height() - ?door_speed * dt
    if h <= ?shut_height
        h = ?shut_height
        p = @self.prop.position
        @self.state["x"] = p.x
        @self.state["y"] = p.y
        @self.state["z"] = p.z
        @self.state["fallen"] = 0.0
        @self.state["phase"] = :dropping:
        if ?engine != null
            play(?engine)
        end
        log("dropship: away")
    end
    set_door(h)
end

-- Dropping: the position is written outright rather than integrated from a
-- velocity, so the ship arrives exactly where it was aimed however the frame
-- rate wandered on the way down. The wander in X and Z is the ride.
def tick_dropping(dt float) -> null
    fallen = @self.state["fallen"]
    step = ?drop_speed * dt * ease(fallen / ?drop_height)
    if fallen + step > ?drop_height
        step = ?drop_height - fallen
    end
    fallen = fallen + step
    @self.state["fallen"] = fallen

    if fallen >= ?drop_height
        @self.prop.position = <@self.state["x"], @self.state["y"] - ?drop_height, @self.state["z"]>
        @self.state["phase"] = :settling:
        if ?engine != null
            stop(?engine)
        end
        play_sound("click", @self)
        @self <- after(900, :open_up:)
        log("dropship: touchdown")
        return
    end

    a = ?shake * ease(fallen / ?drop_height)
    @self.prop.position = <@self.state["x"] + wobble(a, 11.3, 0.0),
                           @self.state["y"] - fallen,
                           @self.state["z"] + wobble(a, 7.7, 1.7)>
end

def on_open(:open_up:) -> null
    @self.state["phase"] = :opening:
end

def tick_opening(dt float) -> null
    h = door_height() + ?door_speed * dt
    if h >= ?open_height
        h = ?open_height
        @self.state["phase"] = :landed:
        log("dropship: ramp clear")
    end
    set_door(h)
end
