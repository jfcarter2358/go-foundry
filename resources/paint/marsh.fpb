# Marsh: shallow, broken water over a hummocky bed, so tussock islands
# break through it; dense reeds standing in the shallows and wet mud
# everywhere between. Wears the murky water_swamp preset.
# docs/guide/36-terrain-paint.md "Ponds, lakes and marshes". Poly Haven
# (CC0): grass_medium_01 (reeds and sedge stand-in), brown_mud_02.
name: Marsh
doc: Shallow broken water over hummocks, tussock islands, dense reeds in the shallows, wet mud.
order: 170
layers:
  - {layer: marsh, strength: 1}
recipe:
  paint:
    - {name: marsh, kind: water}
  textures:
    - {name: pond_mud, id: brown_mud_02, scale: 2}
  material:
    - {layer: marsh, texture: pond_mud, slots: [wet, ash, snow], fallback: cracked, strength: 0.9}
  stages:
    - stage: ground_edit
      id: ground_edit
      params:
        terrain: $source
        water_sounds: true
        water:
          - {layer: marsh, style: marsh, threshold: 0.4, bank: 2, shelf_depth: 0.15, shelf: 2, depth: 0.4,
             noise: 0.08, noise_size: 5, hummocks: 0.6, hummock_size: 4, bank_slope: 0.2, reach: 8, min_area: 20}
    - stage: polyhaven_plants
      id: cover_grass
      params:
        assets: [{id: grass_medium_01}]
        thin_foliage: true
    - stage: grass_field
      id: cover
      params:
        terrain: $terrain
        avoid: $scatter
        rules:
          - {name: marsh_reeds, plants: cover_grass, pieces: tall, density: 2.5, scale: [6, 9], slope: [0, 30],
             cluster: 0.6, cluster_scale: 8, max_triangles: 400, shore: [0, 1.5], shore_soft: 1, max_depth: 0.35,
             paint: marsh, paint_band: [0.2, 0.5],
             tint_a: [0.95, 1.0, 0.7], tint_b: [1.1, 1.0, 0.68], tint_scale: 30, wind_bend: 0.4, wind_flutter: 0.06}
          - {name: shore_sedge, plants: cover_grass, pieces: mid, density: 1.5, scale: [3, 4.5], slope: [0, 30],
             cluster: 0.45, cluster_scale: 20, max_triangles: 500, shore: [1, 9], shore_soft: 3,
             tint_a: [0.9, 1.0, 0.72], tint_b: [1.0, 0.98, 0.66], tint_scale: 40}
