# Scree: broken rock and loose stones on a slope, few plants.
# Poly Haven (CC0): rock_ground_02, stone_01, rock_moss_set_02.
name: Scree
doc: Broken rock and loose stones; grass gives out.
order: 120
layers:
  - {layer: scree, strength: 1}
  - {layer: grass_clear, strength: 0.8}
recipe:
  paint:
    - {name: scree, kind: material}
    - {name: grass_clear, kind: exclude}
  textures:
    - {name: scree, id: rock_ground_02, scale: 3}
  material:
    - {layer: scree, texture: scree, slots: [ash, snow, wet], fallback: gravel}
  exclude:
    - {layer: grass_clear, kind: grass_field, except: [cover]}
  stages:
    - stage: polyhaven_plants
      id: cover_stones
      params:
        assets: [{id: stone_01}, {id: rock_moss_set_02}]
        thin_foliage: false
    - stage: grass_field
      id: cover
      params:
        terrain: $terrain
        avoid: $scatter
        rules:
          - {name: scree_chips, plants: cover_stones, pieces: stone_01, tint_a: [0.7, 0.68, 0.66], tint_b: [0.85, 0.82, 0.78], orient: ground, wind: false, sink: 0.25,
             tilt_jitter: 25, density: 4, scale: [1, 2.5], slope: [0, 60], cliff: [0, 1], cluster: 0, max_triangles: 300,
             paint: scree, paint_band: [0.2, 0.9], range: 0.4, shadows: true}
          - {name: scree_stones, plants: cover_stones, pieces: rock_moss, orient: ground, wind: false, sink: 0.3,
             tilt_jitter: 25, density: 0.8, scale: [0.12, 0.35], slope: [0, 60], cliff: [0, 1], cluster: 0,
             max_triangles: 300, paint: scree, paint_band: [0.3, 1], range: 0.5, shadows: true}
