# Gravel path: a stroke becomes a footpath spline in the ground_edit: gravel
# on a flattened bed with a tidier edge than a dirt trail, grass worn away
# beside it, large rocks and logs kept off; a ford of stepping stones where it
# crosses a river. docs/guide/36-terrain-paint.md "Paths".
# Poly Haven (CC0): gravel_floor, dirt_floor, rock_moss_set_02 (the ford's stones).
name: Gravel path
doc: A gravel path along the stroke on a flattened bed, the grass worn back beside it; stepping stones across water.
order: 105
path:
  style: gravel_path
  width_scale: 1
  simplify: 0.3
  flatten: true
  shape: {blend: 1.0, wear: 1.0, edge: 0.15, edge_size: 2.5}
recipe:
  textures:
    - {name: path_dirt, id: dirt_floor, scale: 2.5}
    - {name: path_gravel, id: gravel_floor, scale: 1.5}
  material:
    - {mask: path_wear, texture: path_dirt, slots: [wet, ash, snow], fallback: cracked, strength: 0.3}
    - {mask: path_gravel_path, texture: path_gravel, slots: [ash, snow, wet], fallback: gravel}
  exclude:
    - {mask: path_wear, kind: grass_field, shrink: 0.6}
    - {mask: path_clear, kind: scatter}
  stages:
    - stage: polyhaven_rocks
      id: path_rocks_src
      params:
        assets: [{id: rock_moss_set_02}]
        back: none
    - stage: ground_edit
      id: ground_edit
      params:
        terrain: $source
        path_rocks: path_rocks_src
